    "three": "^0.180.0",
    "three-stdlib": "^2.36.0"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "^16.3.8"
  },
  "engines": {
    "node": ">=20.9.0"
  }
